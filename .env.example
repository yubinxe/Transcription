# Optional. Official YouTube Data API path for videos the signed-in user owns/manages.
# Create an OAuth 2.0 "Web application" client in Google Cloud, add your origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# EXPERIMENTAL. Reads YouTube's public caption tracks (not an official API).
# Review YouTube's Terms of Service before enabling. Leave unset in production by default.
DAWN_UNOFFICIAL_CAPTIONS=
