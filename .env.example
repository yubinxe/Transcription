# Optional. Official YouTube Data API path for videos the signed-in user owns/manages.
# Create an OAuth 2.0 "Web application" client in Google Cloud, add your origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Link → text on the landing page. Reads the public caption track YouTube shows under
# "스크립트 표시" (not an official API; may change without notice — review YouTube's Terms).
# Set to "enabled" to turn it on. Unset: the landing falls back to pasting the transcript.
DAWN_UNOFFICIAL_CAPTIONS=
